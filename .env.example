# A remplacer par la connexion PostgreSQL distante (Render → Internal/External DB URL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
AUTH_SECRET="change-me-in-production"
# Super-admin plateforme : cet email reçoit PLATFORM_SUPER_ADMIN à la connexion.
TASKPULSE_ADMIN_EMAIL="superadmin@exemple.fr"
# --- Assistant IA (Gemini) ---
# Clé API Google AI Studio : https://aistudio.google.com/apikey
# Noms de variable acceptés (Render/Linux est sensible à la casse) :
#   GEMINI_API_KEY / gemini_api_key / GEMINI_KEY / GOOGLE_API_KEY / google_api_key
# Optionnel : GEMINI_MODEL pour forcer un modèle (défaut : alias gemini-flash-latest,
# sinon résolution automatique via ListModels ; secours gemini-2.5-flash, gemini-2.0-flash).
# Si absente, l'assistant bascule automatiquement sur un mode hors-ligne (réponses prédéfinies).
GEMINI_API_KEY="votre-cle-gemini"

# --- Visioconférence native (Jitsi Meet) ---
# Domaine Jitsi utilisé par le composant <VideoMeeting /> et par la génération
# des identifiants de salles (/api/org/meeting-rooms). Laisser vide pour utiliser
# l'instance publique https://meet.jit.si. Pour un déploiement auto-hébergé,
# indiquer le domaine sans https:// (ex. NEXT_PUBLIC_JITSI_DOMAIN="meet.exemple.fr").
# Le script external_api.js est chargé dynamiquement depuis ce domaine.
NEXT_PUBLIC_JITSI_DOMAIN=""

# --- E-mails transactionnels (SMTP / nodemailer) ---
# Sert à l'envoi réel des liens de réinitialisation de mot de passe et d'invitation.
# Sans ces variables, l'application fonctionne en mode dégradé : les liens
# s'affichent directement à l'écran au lieu d'être envoyés par e-mail.
# Exemple Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER= votre adresse,
# SMTP_PASS= un mot de passe d'application (https://myaccount.google.com/apppasswords).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="MAR-CI Flow <no-reply@marciflow.com>"
# Adresse d'expéditeur effective lue par le mailer (nodemailer). Si SMTP_FROM
# est seul renseigné, il est aussi pris en compte comme repli.
MAIL_FROM="MAR-CI Flow <no-reply@marciflow.com>"

# --- Relance d'expiration d'abonnement (scripts/notify-expiry.ts + workflow) ---
# Le workflow quotidien envoie un e-mail de relance aux admins d'organisation
# dans les 5 jours précédant l'échéance et dès l'expiration (une seule fois par
# échéance grâce à la déduplication). Pour que le lien d'action soit correct :
APP_URL="https://votre-domaine.render.com"
# Seuil de relance anticipée (jours avant expiration). Optionnel, défaut 5.
EXPIRY_WARNING_DAYS="5"
# NB : réutilise SMTP_HOST/PORT/USER/PASS ci-dessus. À déclarer comme secrets
# de dépôt GitHub (Settings → Secrets → Actions) : SMTP_HOST, SMTP_PORT,
# SMTP_USER, SMTP_PASS, MAIL_FROM, APP_URL, DATABASE_URL.

# --- Sauvegardes (scripts/backup.mjs + workflow GitHub Actions) ---
# Le workflow quotidien (.github/workflows/maintenance.yml) exige un secret de
# dépôt nommé DATABASE_URL (Settings → Secrets and variables → Actions).
# Sur Render, aucune action n'est requise : la variable existe déjà.
# BACKUP_DIR (optionnel) : dossier de destination, défaut ./backups

# --- Parcours client d'abonnement (demandes d'activation) ---
# Les notifications e-mail du parcours d'abonnement réutilisent SMTP_* ci-dessus :
#  - une demande envoyée par un admin d'organisation est annoncée à TASKPULSE_ADMIN_EMAIL ;
#  - la remise d'une clé d'activation (console plateforme) est notifiée au contact saisi.
# Sans SMTP configuré, le parcours reste pleinement fonctionnel via la conversation in-app.

