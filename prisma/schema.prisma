generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYE
  STAGIAIRE
}

enum UserStatus {
  ACTIF
  INACTIF
  SUSPENDU
}

enum TaskStatus {
  TERMINE
  EN_COURS
  BLOQUE
  EN_ATTENTE
}

enum TaskPriority {
  BASSE
  MOYENNE
  HAUTE
}

enum ActivityStatus {
  TERMINE
  EN_COURS
  BLOQUE
}

enum JournalEntryStatus {
  BROUILLON
  ENREGISTREE
  VALIDEE
  MODIFICATION_DEMANDEE
  EN_ATTENTE_VALIDATION
}

enum PlatformRole {
  USER
  PLATFORM_SUPER_ADMIN
}

enum OrgRole {
  ORGANIZATION_ADMIN
  EMPLOYEE
  INTERN
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

/// Palier tarifaire (volume de membres), défini en base pour la facturation.
enum PlanTier {
  T1 // 1 à 3 utilisateurs
  T2 // 4 à 10 utilisateurs
  T3 // 11 à 20 utilisateurs
  T4 // 20+ utilisateurs
}

/// Statut de facturation de l'organisation.
enum PlanStatus {
  ACTIVE // Abonnement en cours → accès normal
  EXPIRED // Abonnement expiré → accès verrouillé
  LOCKED // Dépassement de palier → accès verrouillé jusqu'à mise à niveau
}

/// Cycle de vie d'un code de licence (clé d'activation générée par le super-admin).
enum LicenseStatus {
  UNUSED
  USED
  REVOKED
}

model RoleDefinition {
  id          String   @id @default(cuid())
  name        Role    @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
}

model Department {
  id             String        @id @default(cuid())
  name           String
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?
  users          User[]
  tasks          Task[]
  meetingRooms   MeetingRoom[]
  createdAt      DateTime      @default(now())

  @@unique([organizationId, name])
}

model SystemSetting {
  id             String        @id @default(cuid())
  key            String
  value          String
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?
  updatedAt      DateTime      @updatedAt

  @@unique([organizationId, key])
}

model Organization {
  id            String             @id @default(cuid())
  name          String
  slug          String             @unique
  sector        String?
  country       String?
  contactEmail  String?
  phone         String?
  status        OrganizationStatus @default(ACTIVE)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  // --- Monétisation / abonnements ---
  planTier        PlanTier?   // Palier courant (T1/T2/T3/T4)
  planStatus      PlanStatus  @default(ACTIVE)
  planExpiresAt   DateTime?   // Fin de l'abonnement (null = illimité)
  licenseCodeId   String?     @unique // Code d'activation actif
  license         LicenseCode? @relation("OrganizationLicense", fields: [licenseCodeId], references: [id], onDelete: SetNull)

  memberships    Membership[]
  invitations    Invitation[]
  departments    Department[]
  settings       SystemSetting[]
  tasks          Task[]
  activities     Activity[]
  announcements  Announcement[]
  messages       Message[]
  notifications  Notification[]
  attendances    Attendance[]
  journalEntries JournalEntry[]
  journalCategories JournalCategory[]
  meetings       Meeting[]
  meetingRooms   MeetingRoom[]
  leaveRequests  LeaveRequest[]
  timeEntries    TimeEntry[]
  activityEvents ActivityEvent[]
  meetingNotes   MeetingNote[]
  projectDocuments ProjectDocument[]
  planRequests   PlanRequest[]
}

model Membership {
  id             String       @id @default(cuid())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  role           OrgRole      @default(EMPLOYEE)
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Invitation {
  id             String           @id @default(cuid())
  token          String           @unique
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  email          String?
  firstName      String?
  lastName       String?
  role           OrgRole          @default(EMPLOYEE)
  status         InvitationStatus @default(PENDING)
  invitedBy      User             @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())

  @@index([organizationId, status])
}

model User {
  id             String         @id @default(cuid())
  firstName      String
  lastName       String
  username       String         @unique
  email          String         @unique
  phone          String?
  passwordHash   String
  photoUrl       String?
  // @deprecated Rôle global historique — conservé pour compatibilité ; les rôles effectifs
  // vivent désormais dans Membership.role (ORGANIZATION_ADMIN / EMPLOYEE / INTERN).
  role           Role           @default(EMPLOYE)
  status         UserStatus     @default(ACTIF)
  roleDefinition RoleDefinition? @relation(fields: [roleId], references: [id])
  roleId         String?
  department     Department?    @relation(fields: [departmentId], references: [id])
  departmentId   String?
  lastLoginAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  profile        Profile?
  sessions       Session[]
  tasks          Task[]         @relation("TaskAssignee")
  createdTasks   Task[]         @relation("TaskCreator")
  taskComments   TaskComment[]
  attendances    Attendance[]
  activities     Activity[]
  announcements  Announcement[]
  announcementComments AnnouncementComment[]
  announcementReactions AnnouncementReaction[]
  sentMessages   Message[]      @relation("MessageSender")
  receivedMessages Message[]    @relation("MessageRecipient")
  notifications  Notification[]
  auditLogs      AuditLog[]
  workJournal    WorkJournal?
  journalComments JournalComment[]
  journalReports JournalReport[]

  platformRole         PlatformRole @default(USER)
  activeOrganizationId String?
  memberships          Membership[]
  sentInvitations      Invitation[]
  createdMeetings      Meeting[]
  createdMeetingRooms  MeetingRoom[]
  leaveRequests        LeaveRequest[]
  meetingAttendees     MeetingAttendee[]
  passwordResets       PasswordReset[]
  timeEntries          TimeEntry[]
  activityEvents       ActivityEvent[]
  meetingNotesAuthored MeetingNote[]   @relation("MeetingNoteAuthor")
  meetingNotesEdited   MeetingNote[]   @relation("MeetingNoteEditor")
  uploadedDocuments    ProjectDocument[]
  supportMessages      SupportMessage[]
}

model WorkJournal {
  id          String          @id @default(cuid())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String          @unique
  entries     JournalEntry[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model JournalCategory {
  id             String        @id @default(cuid())
  name           String
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?
  entries        JournalEntry[]
  createdAt      DateTime       @default(now())

  @@unique([organizationId, name])
}

model JournalEntry {
  id              String            @id @default(cuid())
  journal         WorkJournal       @relation(fields: [journalId], references: [id], onDelete: Cascade)
  journalId       String
  organization    Organization?     @relation(fields: [organizationId], references: [id])
  organizationId  String?
  category        JournalCategory   @relation(fields: [categoryId], references: [id])
  categoryId      String
  task            Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  taskId          String?
  activity        Activity?         @relation(fields: [activityId], references: [id], onDelete: SetNull)
  activityId      String?
  entryDate       DateTime
  title           String
  summary         String
  workItems       String
  timeMinutes     Int               @default(0)
  difficulties    String?
  solutions       String?
  skills          String?
  result          String?
  personalComment String?
  status          JournalEntryStatus @default(BROUILLON)
  attachments     JournalAttachment[]
  comments        JournalComment[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([journalId, entryDate])
  @@index([categoryId])
  @@index([status])
}

model JournalAttachment {
  id        String       @id @default(cuid())
  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryId   String
  name      String
  url       String
  mimeType  String?
  createdAt DateTime     @default(now())
}

model JournalComment {
  id        String       @id @default(cuid())
  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryId   String
  author    User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  content   String
  createdAt DateTime     @default(now())
}

model JournalReport {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  type        String
  startDate   DateTime
  endDate     DateTime
  title       String
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Profile {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @unique
  position  String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Task {
  id           String       @id @default(cuid())
  title        String
  description  String?
  project      String?
  status       TaskStatus   @default(EN_ATTENTE)
  priority     TaskPriority @default(MOYENNE)
  progress     Int          @default(0)
  dueDate      DateTime?
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  assigneeId   String?
  creator      User         @relation("TaskCreator", fields: [creatorId], references: [id])
  creatorId    String
  department     Department?   @relation(fields: [departmentId], references: [id])
  departmentId   String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?
  createdAt      DateTime      @default(now())
  updatedAt    DateTime     @updatedAt
  comments     TaskComment[]
  journalEntries JournalEntry[]
  timeEntries    TimeEntry[]
  documents      ProjectDocument[]
}

model TaskComment {
  id        String   @id @default(cuid())
  content   String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Attendance {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  organization Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?
  clockIn   DateTime
  clockOut  DateTime?
  latitude  Float?    // Position enregistrée (audit) ; utilisée pour le contrôle GPS optionnel.
  longitude Float?
  // Métadonnées de l'équipement pour l'audit (ex: "mobile-safari").
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([organizationId, clockIn])
}

model Activity {
  id        String   @id @default(cuid())
  title     String
  content   String
  status    ActivityStatus @default(EN_COURS)
  attachmentUrl String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  organization Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?
  createdAt DateTime @default(now())
  journalEntries JournalEntry[]
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  organization Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  comments  AnnouncementComment[]
  reactions AnnouncementReaction[]
}

model AnnouncementComment {
  id             String       @id @default(cuid())
  content        String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  announcementId String
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId       String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model AnnouncementReaction {
  id             String       @id @default(cuid())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  announcementId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  createdAt      DateTime     @default(now())

  @@unique([announcementId, userId])
}

model Message {
  id          String   @id @default(cuid())
  content     String
  sender      User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  senderId    String
  recipient   User     @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId String
  organization Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?
  readAt      DateTime?
  createdAt   DateTime @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  title     String
  content   String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  organization Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  metadata  String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  organizationId String?
  createdAt DateTime @default(now())

    @@index([createdAt])
  @@index([action])
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MeetingAttendeeStatus {
  PENDING
  ACCEPTED
  DECLINED
  TENTATIVE
}

/// Demande de congé / absence (affichée dans le calendrier et le suivi présences).
model LeaveRequest {
  id             String             @id @default(cuid())
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  organization   Organization?      @relation(fields: [organizationId], references: [id])
  organizationId String?
  type           String             @default("CONGE")
  startDate      DateTime
  endDate        DateTime
  reason         String?
  status         LeaveStatus        @default(PENDING)
  decidedById    String?
  decidedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([userId])
  @@index([status])
}

/// Réunion d'équipe (affichée dans le calendrier).
model Meeting {
  id            String            @id @default(cuid())
  title         String
  description   String?
  startAt       DateTime
  endAt         DateTime
  meetingLink   String?
  /// Salle de visioconférence réutilisable (Jitsi) rattachée à la réunion.
  room          MeetingRoom?      @relation(fields: [roomId], references: [id], onDelete: SetNull)
  roomId        String?
  location      String?
  organization  Organization?     @relation(fields: [organizationId], references: [id])
  organizationId String?
  createdBy     User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  attendees     MeetingAttendee[]
  notes         MeetingNote[]

  @@index([organizationId])
  @@index([startAt])
  @@index([roomId])
}

/// Salle de visioconférence Jitsi réutilisable.
/// `roomName` est l'identifiant unique de la salle sur le domaine Jitsi
/// (il forme l'URL https://<domain>/<roomName>) ; il sert aussi de clé de
/// partage entre membres. Une salle peut être rattachée à un projet/équipe
/// (Department) et marquée « par défaut » pour l'organisation.
model MeetingRoom {
  id             String        @id @default(cuid())
  name           String
  roomName       String        @unique
  domain         String        @default("meet.jit.si")
  isDefault      Boolean       @default(false)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  department     Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  departmentId   String?
  createdBy      User          @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  meetings       Meeting[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([departmentId])
}

model MeetingAttendee {
  id        String                @id @default(cuid())
  meeting   Meeting               @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  meetingId String
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  status    MeetingAttendeeStatus   @default(PENDING)

  @@unique([meetingId, userId])
  @@index([userId])
}

/// Jeton de réinitialisation de mot de passe (lien unique, à usage unique).
/// Le mot de passe n'est JAMAIS stocké en clair : seul son hash peut être remplacé.
model PasswordReset {
  id        String    @id @default(cuid())
  tokenHash String    @unique // hash du jeton : le jeton brut n'est jamais enregistré
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  usedAt    DateTime? // null tant que le lien n'a pas été consommé
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Code de licence d'activation : débloque un palier pour une organisation.
model LicenseCode {
  id          String        @id @default(cuid())
  code        String        @unique
  tier        PlanTier
  maxSeats    Int
  note        String?       // Justification / référence de paiement
  status      LicenseStatus @default(UNUSED)
  activatedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime      @default(now())

  organization Organization? @relation("OrganizationLicense")

  @@index([tier])
  @@index([status])
}

/// Entrée de suivi du temps : chronomètre (mode TIMER, endedAt null tant
/// que lancé) ou saisie manuelle (mode MANUAL, durée en minutes).
enum TimeEntryMode {
  TIMER
  MANUAL
}

model TimeEntry {
  id             String        @id @default(cuid())
  mode           TimeEntryMode @default(TIMER)
  task           Task?         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId         String?
  /// Nom du projet (champ libre de Task.project) pour agréger par projet.
  projectName    String?
  /// Titre figé de la tâche au moment de l'entrée (résiste aux renommages/suppressions).
  taskTitle      String?
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String?
  startedAt      DateTime
  endedAt        DateTime?
  /// Durée en minutes (saisie manuelle uniquement).
  minutes        Int?
  note           String?
  createdAt      DateTime      @default(now())

  @@index([organizationId, startedAt])
  @@index([userId, startedAt])
  @@index([taskId])
}

/// Événement du fil d'activité d'équipe : action clé tracée automatiquement
/// (création/modification de tâche, note, livrable, entrée de temps…).
model ActivityEvent {
  id             String        @id @default(cuid())
  action         String // ex: TASK_CREATED, TASK_UPDATED, NOTE_UPDATED, DOCUMENT_ADDED, TIME_LOGGED
  entityType     String // Task | MeetingNote | ProjectDocument | TimeEntry
  entityId       String?
  summary        String // Phrase lisible prête à afficher
  /// Nom du projet concerné (champ libre), pour filtrer le fil par projet.
  projectName    String?
  metadata       String? // JSON libre
  actor          User          @relation(fields: [actorId], references: [id], onDelete: Cascade)
  actorId        String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([projectName])
}

/// Note collaborative de réunion : document partagé lié à une réunion/salle
/// Jitsi et/ou un projet. Éditable par tous les membres de l'organisation,
/// avec traçabilité du dernier éditeur.
model MeetingNote {
  id             String        @id @default(cuid())
  title          String
  content        String        @default("")
  meeting        Meeting?      @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  meetingId      String?
  /// Identifiant de salle Jitsi (roomName) si la note est rattachée à une visio.
  roomName       String?
  /// Nom du projet (champ libre) auquel rattacher le compte-rendu.
  projectName    String?
  author         User          @relation("MeetingNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId       String
  lastEditedBy   User?         @relation("MeetingNoteEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)
  lastEditedById String?
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, updatedAt])
  @@index([meetingId])
  @@index([roomName])
}

/// Livrable partagé : lien externe ou fichier (via URL de stockage) attaché
/// à un projet (nom libre) et/ou une tâche.
model ProjectDocument {
  id             String        @id @default(cuid())
  name           String
  url            String
  /// LINK = lien externe ; FILE = fichier hébergé (URL de stockage).
  kind           String        @default("LINK")
  description    String?
  /// Nom du projet (champ libre) auquel rattacher le livrable.
  projectName    String?
  task           Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  taskId         String?
  uploadedBy     User          @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  uploadedById   String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, projectName])
  @@index([taskId])
}

/// Parcours client d'abonnement : demande d'activation envoyée par
/// l'administrateur d'une organisation au super-admin plateforme depuis la
/// grille tarifaire. Conversation de suivi via SupportMessage.
enum PlanRequestStatus {
  PENDING
  PROCESSING
  APPROVED
  REJECTED
}

model PlanRequest {
  id             String           @id @default(cuid())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  requestedTier  PlanTier
  /// Informations saisies dans le formulaire de demande.
  contactName    String
  contactEmail   String
  contactPhone   String?
  paymentMethod  String // ex: MOBILE_MONEY, VIREMENT, ESPECES
  needs          String? // Besoins / message libre
  status         PlanRequestStatus @default(PENDING)
  decidedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  messages       SupportMessage[]

  @@index([organizationId, status])
  @@index([status, createdAt])
}

/// Message de la conversation support / licence entre l'admin d'une
/// organisation et le super-admin plateforme (y compris remise de clé).
model SupportMessage {
  id         String      @id @default(cuid())
  request    PlanRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId  String
  author     User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId   String
  isSuperAdmin Boolean   @default(false)
  body       String
  /// Clé d'activation éventuellement jointe au message (remise par le super-admin).
  licenseKey String?
  createdAt  DateTime    @default(now())

  @@index([requestId, createdAt])
}

